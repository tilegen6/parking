# =========================================================================
#  Smart Parking — шаблон окружения для всего стека (backend + инфраструктура).
#  Копируется в .env:   cp .env.example .env
#
#  Здесь перечислены ТОЛЬКО те переменные, которые реально использует
#  приложение (src/config.py) и docker-compose. Ничего лишнего.
#
#  Хосты заданы как localhost — для запуска backend локально. В Docker
#  compose сам подменяет их на имена сервисов (postgres/redis/minio),
#  так что для контейнеров эти значения не важны.
# =========================================================================

# --- Приложение ----------------------------------------------------------
APP_NAME=Smart Parking ANPR
APP_ENV=local            # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=parking_user
# СЕКРЕТ — задайте свой пароль (обязателен, без него приложение не стартует)
POSTGRES_PASSWORD=
POSTGRES_DB=parking_db
POSTGRES_HOST=localhost  # в Docker compose переопределит на "postgres"
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
REDIS_HOST=localhost     # в Docker → "redis"
REDIS_PORT=6379
# Пароль опционален: пусто = без авторизации (ок для локалки).
# Для prod: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# --- MinIO (хранилище фото номеров) --------------------------------------
MINIO_ENDPOINT=localhost:9000   # в Docker → "minio:9000"
MINIO_ROOT_USER=minio_admin
# СЕКРЕТ — задайте свой пароль (обязателен)
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=parking-photos
MINIO_SECURE=false
# Публичный URL, по которому отдаются картинки наружу
MINIO_PUBLIC_URL=http://localhost:9000

# --- CORS (адреса фронтенда, через запятую) ------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
