# --- Приложение ----------------------------------------------------------
APP_NAME=Smart Parking ANPR
APP_ENV=local            # local | staging | production
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Публичный адрес сервиса (для ссылок, вебхуков, redirect URI)
SERVICE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

# --- Безопасность / JWT ------------------------------------------------
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=
POSTGRES_DB=parking_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO (хранилище фото номеров / снимков) -------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=parking-plates
MINIO_SECURE=false
# Публичный URL для отдачи картинок наружу
MINIO_PUBLIC_URL=http://localhost:9000

# --- Оплата: активный провайдер ---------------------------------------
# mock  — заглушка (оплата подтверждается из Студии; дефолт для dev/CI)
# kaspi — реальный Kaspi.kz (онлайн-протокол провайдера, см. ниже)
PAYMENT_PROVIDER=mock

# --- Kaspi: онлайн-протокол провайдера (входящий, Kaspi -> нас) --------
# Kaspi дёргает GET /api/kaspi/pay (command=check|pay). Включается флагом;
# защита — список IP-подсетей Kaspi (+ опциональная Basic Auth).
KASPI_PROVIDER_ENABLED=false
# Подсети Kaspi (Протокол взаимодействия, п.1). Через запятую.
KASPI_ALLOWED_IPS=194.187.247.152,194.187.245.108,197.187.244.108,194.187.244.108
# Опциональная Basic Auth поверх IP-allowlist (пусто = не проверяем)
KASPI_PROVIDER_USERNAME=
KASPI_PROVIDER_PASSWORD=
# Формат ответа провайдера: xml (по спецификации) | json
KASPI_PROVIDER_RESPONSE_FORMAT=xml
# Шаблон QR/deeplink для pay_url ({account} = номер авто). Пусто — не формируется.
KASPI_PAY_DEEPLINK_TEMPLATE=

# --- Kaspi: AutomaticPayments (исходящий, мы -> autopayments.kaspi.kz) -
# Автосписание с привязанной карты при въезде/выезде. Basic Auth.
KASPI_AUTOPAY_ENABLED=false
KASPI_AUTOPAY_BASE_URL=https://autopayments.kaspi.kz
KASPI_AUTOPAY_USERNAME=
KASPI_AUTOPAY_PASSWORD=
# ID парковки в системе Kaspi и бесплатное время (сек) для запроса enter
KASPI_PARKING_ID=1
KASPI_FREE_TIME_SECONDS=0
# Таймаут запроса к Kaspi (ТЗ: ответ ≤ 15 c)
KASPI_HTTP_TIMEOUT_SECONDS=15

# --- Мониторинг / Grafana (профиль monitoring) ------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# --- Алерты в Telegram (профиль monitoring) ---------------------------
# Создайте бота через @BotFather, узнайте chat_id (например через @userinfobot).
# Без реальных значений Alertmanager стартует, но не сможет доставлять алерты.
ALERT_TELEGRAM_BOT_TOKEN=changeme
ALERT_TELEGRAM_CHAT_ID=0

# --- Бэкапы PostgreSQL (профиль backup) -------------------------------
# SCHEDULE — cron или метки @daily/@hourly. KEEP_* — сколько копий хранить.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# --- Очистка старых файлов в MinIO (профиль backup) -------------------
# Снимки старше указанного числа дней удаляются автоматически (lifecycle).
MINIO_OBJECT_RETENTION_DAYS=30
