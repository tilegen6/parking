# --- Приложение ----------------------------------------------------------
APP_NAME=Smart Parking ANPR
APP_ENV=local            # local | staging | production
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Публичный адрес сервиса (для ссылок, вебхуков, redirect URI)
SERVICE_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000

# --- Безопасность / JWT ------------------------------------------------
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=
POSTGRES_DB=parking_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO (хранилище фото номеров / снимков) -------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=parking-plates
MINIO_SECURE=false
# Публичный URL для отдачи картинок наружу
MINIO_PUBLIC_URL=http://localhost:9000