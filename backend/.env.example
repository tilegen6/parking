# --- Application ---
APP_NAME=Smart Parking ANPR
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=parking_password
POSTGRES_DB=parking_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Пароль Redis. Пусто = без авторизации (ок для локалки).
# Для prod задайте свой: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_BUCKET=parking-photos
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000

# --- CORS (адреса фронтенда) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
