# --- Приложение --------------------------------------------------------
APP_NAME=smart-parking
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
SERVICE_URL=http://localhost:8000
# Origin'ы фронтенда (Vite :5173 / CRA :3000), через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Безопасность / JWT ------------------------------------------------
SECRET_KEY=change-me-generate-a-random-48-byte-token
JWT_SECRET_KEY=change-me-generate-a-random-48-byte-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=parking_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://parking_user:change-me@postgres:5432/parking_db
DATABASE_URL_SYNC=postgresql://parking_user:change-me@postgres:5432/parking_db

# --- Redis -------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
# Пароль входит в URL после двоеточия: redis://:ПАРОЛЬ@host:port/db
REDIS_URL=redis://:change-me@redis:6379/0

# --- Celery (брокер задач) --------------------------------------------
CELERY_BROKER_URL=redis://:change-me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/1

# --- MinIO (хранилище фото номеров / снимков) -------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=parking-plates
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000

# --- ANPR / LPR камера (Hikvision) ------------------------------------
CAMERA_BRAND=hikvision
CAMERA_IP=192.168.1.64
CAMERA_PORT=80
CAMERA_USER=admin
CAMERA_PASSWORD=
CAMERA_RTSP_URL=rtsp://admin:change-me@192.168.1.64:554/Streaming/Channels/101
ANPR_MIN_CONFIDENCE=80

# --- Мониторинг (опционально) -----------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
