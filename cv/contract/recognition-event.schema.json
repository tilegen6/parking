{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-parking/cv/contract/recognition-event.schema.json",
  "title": "RecognitionEvent",
  "description": "Vendor-neutral normalized recognition event (cv -> backend contract).",
  "type": "object",
  "required": ["plate_number", "direction", "event_time", "source"],
  "additionalProperties": false,
  "properties": {
    "plate_raw": {"type": ["string", "null"], "maxLength": 32},
    "normalization_status": {"type": "string", "enum": ["ok", "corrected", "ambiguous", "unknown_format"]},
    "plate_number": {
      "type": ["string", "null"],
      "maxLength": 32,
      "description": "Recognized plate, null if not recognized."
    },
    "direction": {
      "type": "string",
      "enum": ["ENTRY", "EXIT", "UNKNOWN"]
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 with timezone offset."
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "camera_name": {
      "type": ["string", "null"],
      "maxLength": 255
    },
    "source": {
      "type": "string",
      "description": "Recognizer id, e.g. hikvision-anpr or own-cv-v1.",
      "examples": ["hikvision-anpr", "own-cv-v1"]
    },
    "photos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plate": { "type": ["string", "null"], "format": "uri" },
        "vehicle": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "raw_ref": {
      "type": ["string", "null"],
      "description": "Pointer to raw payload for debugging."
    }
  }
}
