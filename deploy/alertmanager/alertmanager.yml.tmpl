# Шаблон конфигурации Alertmanager. Значения ${...} подставляются из .env
# init-контейнером (envsubst) при старте, чтобы токен не лежал в репозитории.
#
# Канал по умолчанию — Telegram. Чтобы переключиться на e-mail/Slack,
# замените блок receivers (примеры закомментированы ниже).
route:
  receiver: telegram
  group_by: ["alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: "${ALERT_TELEGRAM_BOT_TOKEN}"
        chat_id: ${ALERT_TELEGRAM_CHAT_ID}
        parse_mode: HTML
        send_resolved: true
        message: |
          {{ range .Alerts }}<b>[{{ .Status | toUpper }}] {{ .Labels.severity | toUpper }}</b>
          {{ .Annotations.summary }}
          {{ .Annotations.description }}
          {{ end }}

