# Прод-образ фронтенда: multi-stage сборка Vite → отдача статики через nginx.
# Собирается только в CI (build-and-push) и для прода. Локальная разработка
# использует обычный Dockerfile (Vite dev-сервер с hot-reload).

# ── 1. Build: собираем статику ──────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

# Публичные адреса API/CV вшиваются в бандл на этапе сборки (Vite import.meta.env).
# В CI пробрасываются build-args (VITE_API_URL=https://<домен>).
ARG VITE_API_URL=http://localhost:8000
ARG VITE_CV_URL=http://localhost:8090
ENV VITE_API_URL=$VITE_API_URL \
    VITE_CV_URL=$VITE_CV_URL

COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
RUN npm run build

# ── 2. Runtime: nginx отдаёт dist ───────────────────────────────────
FROM nginx:alpine AS runtime
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1

CMD ["nginx", "-g", "daemon off;"]
